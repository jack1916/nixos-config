# Hardware / disk configuration for the Hetzner Cloud VPS.
#
# Unlike the homeserver (whose file is generated by nixos-generate-config),
# this one is maintained by hand, because disk partitioning is not managed
# by this flake. nixos-infect converts the provider's stock Ubuntu image
# IN PLACE, so the machine keeps Hetzner's default partition layout:
#
#   /dev/sda1   ext4   -> /          (Ubuntu's root, converted to NixOS)
#   /dev/sda14  1M     bios_grub     (grub core image on LEGACY BIOS)
#   /dev/sda15  vfat   -> /boot/efi
#
# nixos-infect preserves these filesystems (it only relabels the root
# device for the lightsail provider), so the UUIDs below stay valid across
# the conversion. They identify the CURRENTLY provisioned disk.
#
# IF YOU REBUILD OR RECREATE THE SERVER, these UUIDs change. Get the new
# ones with either:
#     lsblk -f                      (from the Ubuntu image)
#     blkid                         (from an existing NixOS install)
# then update the two device lines below. A mismatch here means the system
# will not mount its root filesystem and will not boot.
{
  config,
  lib,
  modulesPath,
  ...
}:

{
  imports = [
    (modulesPath + "/profiles/qemu-guest.nix")
  ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/9e4ec673-4345-4852-8a69-0f7f3df29989";
    fsType = "ext4";
  };

  # Hetzner's EFI system partition. Mounted even on this legacy-BIOS boot
  # setup because the partition exists and grub's installer expects the
  # mountpoint to be present.
  fileSystems."/boot/efi" = {
    device = "/dev/disk/by-uuid/A948-365C";
    fsType = "vfat";
    options = [ "fmask=0077" "dmask=0077" ];
  };

  swapDevices = [ ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
}
