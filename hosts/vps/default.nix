# Public VPS gateway for Plex.
#
# Role: hold the static public IP (2.31.95.62), terminate TLS for
# plex.9485432.xyz, and reverse-proxy through a WireGuard tunnel to Plex
# on the homeserver (10.100.0.2:32400). The homeserver is behind carrier
# NAT, so it dials out to this host and its home IP is never exposed.
#
# Installed with nixos-infect over a stock Hetzner Ubuntu image, then
# switched to this flake. See README.md for the full procedure.
#
# NOTE: disk partitioning is NOT declared here. nixos-infect converts the
# existing Ubuntu install in place, so the disk keeps Hetzner's partition
# layout. Networking is likewise generated by nixos-infect into
# /etc/nixos/networking.nix (Hetzner uses a /32 address with an onlink
# gateway, which plain DHCP cannot express).
{
  config,
  lib,
  pkgs,
  inputs,
  modulesPath,
  ...
}:

{
  imports = [
    ./hardware-configuration.nix
    ./networking.nix
    ./wireguard.nix
    ./caddy.nix
    inputs.sops-nix.nixosModules.sops
  ];

  # --- Platform ---------------------------------------------------------
  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  system.stateVersion = "25.11";

  # Hetzner x86_64 cloud VMs boot via LEGACY BIOS, so grub (not
  # systemd-boot, which needs UEFI). nixos-infect also sets this when it
  # generates the initial config; keeping it here means the flake alone is
  # sufficient after the first switch, independent of the generated files.
  boot.loader.grub.enable = true;
  boot.loader.grub.device = "/dev/sda";
  boot.loader.timeout = 3;

  # Single-disk VPS: make sure the initrd has virtio/virtio-scsi drivers so
  # the machine boots on any KVM provider.
  boot.initrd.availableKernelModules = [
    "virtio_pci"
    "virtio_scsi"
    "virtio_blk"
    "ahci"
    "sd_mod"
    "sr_mod"
    "ext4"
  ];
  boot.kernelModules = [ ];

  # --- Basics -----------------------------------------------------------
  networking.hostName = "vps";
  time.timeZone = "Europe/Dublin";

  # Networking is NOT declared statically in this flake. nixos-infect
  # writes /etc/nixos/networking.nix from the live system, capturing
  # Hetzner's /32 address and onlink gateway, and that generated file must
  # be imported alongside this module (see README).
  #
  # DHCP is explicitly disabled to AVOID A CONFLICT: nixos-infect's config
  # sets dhcpcd.enable = false and assigns the address statically. Leaving
  # DHCP on (the NixOS default) would make dhcpcd race the static config on
  # eth0, producing duplicate addresses or a lost default route.
  networking.useDHCP = lib.mkForce false;
  networking.dhcpcd.enable = lib.mkForce false;

  # Hetzner VMs are KVM/QEMU; virtio_gpu plus the serial console keep the
  # web console usable (logs are also sent to ttyS0).
  boot.initrd.kernelModules = [ "virtio_gpu" ];
  boot.kernelParams = [ "console=tty1" "console=ttyS0" ];

  nix.settings = {
    experimental-features = [
      "nix-command"
      "flakes"
    ];
    # Keep the tiny 40GB root disk from filling up with old closures.
    trusted-users = [
      "root"
      "@wheel"
    ];
  };

  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 14d";
  };
  nix.optimise.automatic = true;

  environment.systemPackages = with pkgs; [
    vim
    git
    htop
    tcpdump
    wireguard-tools
    dig
  ];

  # --- Access -----------------------------------------------------------
  services.openssh = {
    enable = true;
    # Key-only access; this box is on the open internet.
    settings = {
      PasswordAuthentication = false;
      KbdInteractiveAuthentication = false;
      PermitRootLogin = "prohibit-password";
    };
  };

  # root keeps key-only SSH so nixos-anywhere (which connects as root) and
  # post-install recovery both work. Password login stays disabled.
  users.users.root.openssh.authorizedKeys.keys = [
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIE+aHyrXiBrZZaJ6kQTwBq8buMW4CGB0YaaLgO0OsxSc jack@arch-laptop-jack"
  ];

  # Emergency admin user.
  users.users.jack = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    openssh.authorizedKeys.keys = [
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIE+aHyrXiBrZZaJ6kQTwBq8buMW4CGB0YaaLgO0OsxSc jack@arch-laptop-jack"
    ];
  };
  security.sudo.wheelNeedsPassword = false;

  # --- Firewall ---------------------------------------------------------
  # Default deny inbound. Explicit allows:
  #   80/443 tcp  -> Caddy (ACME + Plex TLS)   [caddy.nix]
  #   51820 udp   -> WireGuard                 [wireguard.nix]
  #   22 tcp      -> SSH                       [here]
  # Everything else incoming is dropped.
  networking.firewall.enable = true;
  networking.firewall.allowedTCPPorts = [ 22 ];

  # No NAT/forwarding: Caddy proxies in userspace, the tunnel is not a
  # routed network for clients.
  boot.kernel.sysctl = {
    "net.ipv4.ip_forward" = lib.mkDefault 0;
    "net.ipv6.conf.all.forwarding" = lib.mkDefault 0;
  };

  # --- Secrets ----------------------------------------------------------
  # Secrets are deployed via sops-nix. The age key must be present at
  # /var/lib/sops-nix/key.txt on this host (see README for generation).
  sops.age.keyFile = "/var/lib/sops-nix/key.txt";
  sops.defaultSopsFile = ./../../secrets/vps.yaml;
  sops.defaultSopsFormat = "yaml";

  # --- Unattended upgrades ---------------------------------------------
  # Pull from GitHub. The lock advances only via the weekly Update Flake
  # Lock PR, which is gated on both hosts building; do NOT add
  # `--update-input nixpkgs` here or this host would resolve its own
  # nixpkgs and bypass that gate.
  system.autoUpgrade = {
    enable = true;
    flake = "github:jack1916/nixos-config#vps";
    # Runs at 03:00 and is permitted to reboot until 03:30. The window must
    # CONTAIN the run time: allowReboot compares the wall clock against
    # rebootWindow, and if the service finds itself outside it the reboot
    # is skipped silently and deferred to the next run.
    dates = "03:00";
    # Stagger against the homeserver, which also runs at 03:00, so the two
    # do not fetch from GitHub at the same instant. The delay is applied to
    # the timer, so the reboot window below still bounds the actual reboot.
    randomizedDelaySec = "10m";
    # Wide enough to cover the random delay plus a full rebuild. If the
    # service finishes outside this window the reboot is skipped SILENTLY
    # and deferred to the next run, so do not narrow it to just the delay.
    rebootWindow = {
      lower = "03:00";
      upper = "04:30";
    };
    # A reboot only happens when the KERNEL, initrd or kernel modules
    # actually changed - the module compares booted vs built and does a
    # plain switch otherwise. So this is not a nightly reboot; it is a
    # reboot only when a reboot is needed to apply a patch.
    #
    # Plex is briefly unreachable for remote clients during that reboot.
    # 03:00-03:30 was chosen as the low-traffic window.
    allowReboot = true;
  };
}
